{
  "name": "news-watcher",
  "version": "1.0.0",
  "description": "Real-time CoinDesk crypto news monitor using Playwright — no API keys required",
  "main": "scripts/watch-news.js",
  "type": "module",
  "scripts": {
    "watch": "node scripts/watch-news.js",
    "watch:coindesk": "node scripts/watch-news.js --site coindesk",
    "watch:panews": "node scripts/watch-news.js --site panews"
  },
  "dependencies": {
    "playwright": "^1.40.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": ["crypto", "news", "playwright", "monitor", "telegram", "coindesk", "openclaw"],
  "license": "MIT"
}
